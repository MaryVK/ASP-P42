@*  Приймаємо модель представлення (від контролера),
    тут зазначаємо лише тип, самі дані доступні 
    через Razor-властивість Model

    какие поля показываем.
    Это страница, которая рассказывает про модели.
    Здесь пользователь ЗАПОЛНЯЕТ форму
*@
@model ASP_P42.Models.Home.Models.HomeModelsViewModel


@{
    ViewData["Title"] = "Models";
}

<div class="text-center page-title">
    <h1 class="display-4">
        @* звернення до даних моделі, що приходить від контролера *@
        @Model.PageTitle
    </h1>
</div>

<p class="intro">@Model.Intro</p>

<p class="classification-header">@Model.ClassificationHeader</p>

<ul class="classification-list">
    @foreach(var item in Model.ClassificationList)
    {
        <li>@item</li>
    }
</ul>
<p class="example-header">@Model.ExampleHeader</p>
<ul class="example-list">
    @foreach (var item in Model.ExampleList)
    {
        <li>@item</li>
    }
</ul>

<form asp-action="ModelsForm" method="post">
    Login: <input name="user-login" />
    <br/>
    Password: <input name="user-password" type="password" />
    <br/>
    <label>
        <input type="checkbox" name="agree" value="true" />
        Я согласен(-а)
    </label>
    <br />
    <p>Пол:</p>

    <label>
        <input type="radio" name="gender" value="male" />
        Мужчина
    </label>

    <label>
        <input type="radio" name="gender" value="female" />
        Женщина
    </label>

    <br />
    <label>
        Дата рождения:
        <input type="date" name="birth-date" />
    </label>

    <br />
    <label>
        Любимый цвет:
        <input type="color" name="color" />
    </label>

    <br />
    <label>
        Возраст:
        <input type="number" name="age" />
    </label>

    <br />

    <button>GO</button>
</form>
